{
  "appId": "br.com.chegouai.app",
  "appName": "Chegô",
  "webDir": "www",
  "server": {
    "url": "https://chegouaiapp.com.br/app",
    "cleartext": false,
    "allowNavigation": ["chegouaiapp.com.br"]
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "Geolocation": {
      "permissions": ["location", "coarseLocation"]
    }
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}
